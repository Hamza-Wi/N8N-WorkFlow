    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  // جلب البيانات بناءً على أسماء الحقول (Labels) في العقدة السابقة\n  const rating = item.json.Rating;\n  const feedback = item.json.Feedback;\n\n  // التحقق من أن التقييم بين 1 و 5\n  if (rating < 1 || rating > 5) {\n    throw new Error(\"عذراً، التقييم يجب أن يكون بين 1 و 5. القيمة المدخلة: \" + rating);\n  }\n\n  // حساب عدد الكلمات في الملاحظات\n  let wordCount = 0;\n  if (feedback && typeof feedback === 'string') {\n    // إزالة المسافات الزائدة من الأطراف ثم تقسيم النص لحساب الكلمات\n    wordCount = feedback.trim().split(/\\s+/).length;\n  }\n\n  // إضافة عدد الكلمات كحقل جديد في البيانات لتمريرها لعقدة الذكاء الاصطناعي\n  item.json.wordCount = wordCount;\n}\n\n// إرجاع البيانات المحدثة\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
